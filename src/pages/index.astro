---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div>
					<p class="eyebrow">Arcade Builder</p>
					<h1>🏎️ Turbo Trail Racers</h1>
					<p class="lede">
						Pick your racer, choose from eight unique tracks, and hit space bar to fire off items
						during the race.
					</p>
					<div class="controls">
						<div class="control">
							<span class="label">Accelerate</span>
							<span class="value">Hold ⬆️</span>
						</div>
						<div class="control">
							<span class="label">Brake</span>
							<span class="value">Hold ⬇️</span>
						</div>
						<div class="control">
							<span class="label">Use Item</span>
							<span class="value">Press Space</span>
						</div>
					</div>
					<button class="primary" id="start-race">Start Race</button>
				</div>
				<div class="scoreboard">
					<h2>Race Status</h2>
					<p id="race-status">Select a racer and track to begin.</p>
					<div class="stat-grid">
						<div>
							<span class="label">Track</span>
							<strong id="current-track">-</strong>
						</div>
						<div>
							<span class="label">Racer</span>
							<strong id="current-racer">-</strong>
						</div>
						<div>
							<span class="label">Lap Progress</span>
							<strong id="lap-progress">0%</strong>
						</div>
						<div>
							<span class="label">Item Slot</span>
							<strong id="item-slot">Empty</strong>
						</div>
					</div>
				</div>
			</section>

			<section class="grid">
				<div class="panel">
					<h2>Choose Your Racer</h2>
					<div class="card-grid" id="racer-options"></div>
				</div>
				<div class="panel">
					<h2>Pick a Track (8 total)</h2>
					<div class="card-grid tracks" id="track-options"></div>
				</div>
			</section>

			<section class="panel race-panel">
				<h2>Race View</h2>
				<div class="track">
					<div class="track-lines"></div>
					<div class="car player" id="player-car">
						<span class="car-name" id="player-name">Racer</span>
					</div>
					<div class="car rival" id="rival-car">
						<span class="car-name">Rival</span>
					</div>
					<div class="finish">Finish</div>
				</div>
				<div class="meter">
					<div class="meter-fill" id="meter-fill"></div>
				</div>
			</section>
		</main>
		<Footer />
		<script type="module">
			const racers = [
				{
					id: 'nova',
					name: 'Nova Blitz',
					style: 'Boost Specialist',
					speed: 4.8,
					boost: 1.5,
					control: 4.2
				},
				{
					id: 'rift',
					name: 'Rift Rider',
					style: 'Grip Guru',
					speed: 4.2,
					boost: 1.3,
					control: 4.8
				},
				{
					id: 'zen',
					name: 'Zen Drift',
					style: 'Balanced',
					speed: 4.5,
					boost: 1.4,
					control: 4.5
				},
				{
					id: 'aurora',
					name: 'Aurora Flux',
					style: 'Tech Tactician',
					speed: 4.3,
					boost: 1.6,
					control: 4.1
				},
				{
					id: 'blaze',
					name: 'Blaze Circuit',
					style: 'Top Speed',
					speed: 5.1,
					boost: 1.2,
					control: 3.9
				}
			];

			const tracks = [
				{ id: 'neon', name: 'Neon Harbor', detail: 'Night docks + slick turns', length: 1200 },
				{ id: 'canyon', name: 'Copper Canyon', detail: 'Wide straights + wind', length: 1350 },
				{ id: 'glacier', name: 'Glacier Loop', detail: 'Ice patches + tight chicanes', length: 1280 },
				{ id: 'metro', name: 'Metro Circuit', detail: 'Downtown tunnels', length: 1250 },
				{ id: 'garden', name: 'Sky Garden', detail: 'Floating bends', length: 1150 },
				{ id: 'driftway', name: 'Driftway 77', detail: 'Desert drifts', length: 1400 },
				{ id: 'summit', name: 'Summit Run', detail: 'High altitude climbs', length: 1500 },
				{ id: 'vortex', name: 'Vortex Vale', detail: 'Storm surge + boosts', length: 1300 }
			];

			const items = [
				{ id: 'boost', name: 'Turbo Boost', effect: 'speed', value: 2.2 },
				{ id: 'shield', name: 'Ion Shield', effect: 'slow', value: 0.7 },
				{ id: 'spark', name: 'Spark Burst', effect: 'speed', value: 1.6 }
			];

			const racerOptions = document.querySelector('#racer-options');
			const trackOptions = document.querySelector('#track-options');
			const startButton = document.querySelector('#start-race');
			const raceStatus = document.querySelector('#race-status');
			const currentTrack = document.querySelector('#current-track');
			const currentRacer = document.querySelector('#current-racer');
			const lapProgress = document.querySelector('#lap-progress');
			const itemSlot = document.querySelector('#item-slot');
			const playerCar = document.querySelector('#player-car');
			const playerName = document.querySelector('#player-name');
			const rivalCar = document.querySelector('#rival-car');
			const meterFill = document.querySelector('#meter-fill');

			let selectedRacer = racers[0];
			let selectedTrack = tracks[0];
			let item = null;
			let progress = 0;
			let rivalProgress = 0;
			let speed = 0;
			let isRacing = false;
			let accelerating = false;
			let braking = false;
			let boostTimer = 0;
			let slowTimer = 0;

			const renderCards = () => {
				racerOptions.innerHTML = '';
				racers.forEach((racer) => {
					const card = document.createElement('button');
					card.className = `card ${racer.id === selectedRacer.id ? 'selected' : ''}`;
					card.type = 'button';
					card.innerHTML = `
						<h3>${racer.name}</h3>
						<p>${racer.style}</p>
						<div class="stats">
							<span>Speed ${racer.speed.toFixed(1)}</span>
							<span>Boost ${racer.boost.toFixed(1)}</span>
							<span>Control ${racer.control.toFixed(1)}</span>
						</div>
					`;
					card.addEventListener('click', () => {
						selectedRacer = racer;
						playerName.textContent = racer.name;
						currentRacer.textContent = racer.name;
						renderCards();
					});
					racerOptions.append(card);
				});

				trackOptions.innerHTML = '';
				tracks.forEach((track) => {
					const card = document.createElement('button');
					card.className = `card ${track.id === selectedTrack.id ? 'selected' : ''}`;
					card.type = 'button';
					card.innerHTML = `
						<h3>${track.name}</h3>
						<p>${track.detail}</p>
						<div class="stats">
							<span>${track.length}m</span>
						</div>
					`;
					card.addEventListener('click', () => {
						selectedTrack = track;
						currentTrack.textContent = track.name;
						renderCards();
					});
					trackOptions.append(card);
				});
			};

			const resetRace = () => {
				progress = 0;
				rivalProgress = 0;
				speed = 0;
				boostTimer = 0;
				slowTimer = 0;
				item = items[Math.floor(Math.random() * items.length)];
				itemSlot.textContent = item.name;
				lapProgress.textContent = '0%';
				meterFill.style.width = '0%';
				playerCar.style.transform = 'translateX(0%)';
				rivalCar.style.transform = 'translateX(0%)';
				raceStatus.textContent = 'Engines ready. Hold ⬆️ to launch!';
			};

			const startRace = () => {
				if (!selectedRacer || !selectedTrack) {
					raceStatus.textContent = 'Pick a racer and track first!';
					return;
				}
				isRacing = true;
				resetRace();
				currentTrack.textContent = selectedTrack.name;
				currentRacer.textContent = selectedRacer.name;
				playerName.textContent = selectedRacer.name;
			};

			const applyItem = () => {
				if (!item || !isRacing) return;
				if (item.effect === 'speed') {
					boostTimer = 120;
					raceStatus.textContent = `${item.name} activated! Speed surge!`;
				} else if (item.effect === 'slow') {
					slowTimer = 120;
					raceStatus.textContent = `${item.name} active! Rival slowed.`;
				}
				item = null;
				itemSlot.textContent = 'Empty';
			};

			const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

			const updateRace = () => {
				if (isRacing) {
					const baseAccel = selectedRacer.speed * 0.02;
					const brakeDecel = selectedRacer.control * 0.03;
					const drag = 0.01;
					if (accelerating) speed += baseAccel;
					if (braking) speed -= brakeDecel;
					speed -= drag;
					speed = clamp(speed, 0, 8);

					let playerBoost = 1;
					if (boostTimer > 0) {
						playerBoost = selectedRacer.boost;
						boostTimer -= 1;
					}

					let rivalBoost = 1.1;
					if (slowTimer > 0) {
						rivalBoost = 0.7;
						slowTimer -= 1;
					}

					progress += speed * playerBoost;
					rivalProgress += 4.5 * rivalBoost;

					const percent = clamp((progress / selectedTrack.length) * 100, 0, 100);
					const rivalPercent = clamp((rivalProgress / selectedTrack.length) * 100, 0, 100);
					lapProgress.textContent = `${Math.floor(percent)}%`;
					meterFill.style.width = `${percent}%`;
					playerCar.style.transform = `translateX(${percent}%)`;
					rivalCar.style.transform = `translateX(${rivalPercent}%)`;

					if (percent >= 100 || rivalPercent >= 100) {
						isRacing = false;
						raceStatus.textContent =
							percent >= 100
								? `Finish line! ${selectedRacer.name} wins!`
								: 'Photo finish! Rival edges ahead.';
						itemSlot.textContent = 'Empty';
					}
				}
				requestAnimationFrame(updateRace);
			};

			document.addEventListener('keydown', (event) => {
				if (event.code === 'ArrowUp') accelerating = true;
				if (event.code === 'ArrowDown') braking = true;
				if (event.code === 'Space') {
					event.preventDefault();
					applyItem();
				}
			});

			document.addEventListener('keyup', (event) => {
				if (event.code === 'ArrowUp') accelerating = false;
				if (event.code === 'ArrowDown') braking = false;
			});

			startButton?.addEventListener('click', startRace);
			renderCards();
			resetRace();
			updateRace();
		</script>
		<style>
			main {
				display: flex;
				flex-direction: column;
				gap: 2.5rem;
			}

			.hero {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 2rem;
				align-items: center;
			}

			.eyebrow {
				text-transform: uppercase;
				letter-spacing: 0.2em;
				font-size: 0.75rem;
				color: var(--accent-dark);
				font-weight: 600;
			}

			.lede {
				font-size: 1.1rem;
				line-height: 1.6;
			}

			.controls {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
				margin: 1.5rem 0;
			}

			.control {
				background: var(--accent-light);
				border-radius: 999px;
				padding: 0.5rem 1rem;
				display: flex;
				gap: 0.5rem;
				align-items: center;
				font-size: 0.9rem;
			}

			.primary {
				background: var(--accent);
				color: white;
				padding: 0.75rem 1.5rem;
				border-radius: 999px;
				border: none;
				font-weight: 600;
				cursor: pointer;
				box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
			}

			.scoreboard {
				background: var(--accent-light);
				border-radius: 1.5rem;
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.stat-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
				gap: 1rem;
			}

			.label {
				display: block;
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: var(--gray);
			}

			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 2rem;
			}

			.panel {
				background: white;
				border-radius: 1.5rem;
				padding: 1.5rem;
				box-shadow: 0 20px 45px rgba(15, 23, 42, 0.08);
			}

			.card-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
				gap: 1rem;
				margin-top: 1rem;
			}

			.card {
				border: 1px solid rgba(15, 23, 42, 0.08);
				border-radius: 1rem;
				padding: 1rem;
				text-align: left;
				background: white;
				cursor: pointer;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}

			.card:hover,
			.card.selected {
				transform: translateY(-4px);
				box-shadow: 0 15px 30px rgba(15, 23, 42, 0.12);
				border-color: var(--accent);
			}

			.card h3 {
				margin: 0 0 0.35rem;
			}

			.card p {
				margin: 0 0 0.75rem;
				color: var(--gray);
			}

			.stats {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				font-size: 0.8rem;
				color: var(--accent-dark);
			}

			.race-panel {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.track {
				position: relative;
				background: linear-gradient(90deg, #0f172a 0%, #1e293b 100%);
				border-radius: 1.5rem;
				height: 200px;
				overflow: hidden;
				padding: 1.5rem;
			}

			.track-lines {
				position: absolute;
				inset: 50% 0 auto 0;
				height: 6px;
				background: repeating-linear-gradient(90deg, #38bdf8, #38bdf8 20px, transparent 20px, transparent 40px);
				opacity: 0.4;
			}

			.car {
				position: absolute;
				left: 1.5rem;
				width: 120px;
				height: 50px;
				border-radius: 999px;
				display: flex;
				align-items: center;
				justify-content: center;
				color: white;
				font-weight: 600;
				box-shadow: 0 10px 25px rgba(15, 23, 42, 0.45);
				transition: transform 0.2s ease;
			}

			.car.player {
				background: linear-gradient(120deg, #38bdf8, #6366f1);
				top: 45px;
			}

			.car.rival {
				background: linear-gradient(120deg, #f97316, #f43f5e);
				top: 115px;
			}

			.car-name {
				font-size: 0.75rem;
				text-align: center;
				padding: 0 0.5rem;
			}

			.finish {
				position: absolute;
				right: 20px;
				top: 20px;
				height: 160px;
				width: 70px;
				border-left: 4px dashed rgba(255, 255, 255, 0.6);
				display: flex;
				align-items: center;
				justify-content: center;
				color: rgba(255, 255, 255, 0.7);
				font-weight: 600;
				font-size: 0.8rem;
				text-transform: uppercase;
				letter-spacing: 0.15em;
			}

			.meter {
				height: 12px;
				background: rgba(15, 23, 42, 0.1);
				border-radius: 999px;
				overflow: hidden;
			}

			.meter-fill {
				height: 100%;
				width: 0%;
				background: linear-gradient(90deg, #38bdf8, #6366f1);
				transition: width 0.2s ease;
			}

			@media (max-width: 700px) {
				.car {
					width: 90px;
				}
			}
		</style>
	</body>
</html>
